# ==============================================================================
# HAMEAU — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust values if needed.
# By default, HAMEAU runs locally on your GPU (RTX 3050+ recommended) or in Mock mode.

# --- AWS Bedrock Configuration ---
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# Optional AWS Credentials (if not using ~/.aws/credentials or IAM role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Strands Decider 2B Inference Configuration ---
DECIDER_MODEL_ID=StrandsAgents/strands-decider-2B-hobson-v21

# DECIDER_URLS:
# Leave empty to run Decider 2B locally on your GPU (backend: local_gpu)
# Or specify comma-separated remote worker endpoints (e.g., Google Colab / Cloudflare Tunnel)
DECIDER_URLS=

# --- Simulation Logging & Seed ---
HAMEAU_SEED=42
HAMEAU_DAYS=3
HAMEAU_TICKS_PER_DAY=192
